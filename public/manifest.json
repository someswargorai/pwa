{
  "id": "/",
  "name": "Nexus Storefront",
  "short_name": "Nexus",
  "description": "Premium E-Commerce Experience",
  "start_url": "/",
  "background_color": "#ffffff",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#2563eb",
  "dir": "ltr",
  "lang": "en-US",
  "categories": ["shopping", "business"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/dashboard_mockup.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Nexus Storefront Dashboard"
    },
    {
      "src": "/dashboard_mockup.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Nexus Storefront Mobile View"
    }
  ],
  "shortcuts": [
    {
      "name": "Open Forms",
      "short_name": "Forms",
      "description": "Go directly to the form page",
      "url": "/form",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any maskable"
        }
      ]
    }
  ],
  "display_override": ["window-controls-overlay", "tabbed", "minimal-ui"],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/plain": [".txt"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "note_taking": {
    "new_note_url": "/form"
  },
  "protocol_handlers": [
    {
      "protocol": "web+nexus",
      "url": "/?url=%s"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "widgets": [
    {
      "name": "Nexus Widget",
      "description": "Quick view of Nexus storefront",
      "tag": "nexus-widget",
      "ms_ac_template": "/widget.json",
      "data": "/widget-data.json",
      "type": "application/json"
    }
  ]
}